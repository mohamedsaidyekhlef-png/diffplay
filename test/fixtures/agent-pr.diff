diff --git a/src/components/SeatManager.tsx b/src/components/SeatManager.tsx
new file mode 100644
index 0000000..c433c37
--- /dev/null
+++ b/src/components/SeatManager.tsx
@@ -0,0 +1,19 @@
+"use client";
+import { useState } from "react";
+import { PlanBadge } from "./PlanBadge";
+
+export function SeatManager({ teamId, used, paid, note }: { teamId: string; used: number; paid: number; note: string }) {
+  const [busy, setBusy] = useState(false);
+  async function add() {
+    setBusy(true);
+    await fetch(`/api/teams/${teamId}/seats`, { method: "POST" });
+    setBusy(false);
+  }
+  return (
+    <div className="seats">
+      <PlanBadge plan="team" used={used} paid={paid} />
+      <div dangerouslySetInnerHTML={{ __html: note }} />
+      <button onClick={add} disabled={busy}>Add a seat</button>
+    </div>
+  );
+}
