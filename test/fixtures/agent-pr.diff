diff --git a/src/lib/seats.ts b/src/lib/seats.ts
new file mode 100644
index 0000000..6202390
--- /dev/null
+++ b/src/lib/seats.ts
@@ -0,0 +1,13 @@
+import { db } from "./db";
+
+/** Count members on a team and compare with paid seats. */
+export async function seatUsage(teamId: string) {
+  const team = await db.team.findUnique({ where: { id: teamId }, include: { users: true } });
+  if (!team) return { used: 0, paid: 0, over: false };
+  const used = team.users.length;
+  return { used, paid: team.seats, over: used > team.seats };
+}
+
+export function formatSeats(used: number, paid: number) {
+  return `${used} of ${paid} seats`;
+}
